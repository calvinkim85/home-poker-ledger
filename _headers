# Cloudflare Pages reads this file from the build output root and sends these
# response headers with every page. GitHub Pages ignores it — so these
# protections only take effect once the site is served from Cloudflare Pages.
# See docs/cloudflare-migration.md.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
